# Copy to .env and fill in. Never commit .env.
ODDS_API_KEY=your_key_here
# Base URL - override only if the provider changes it.
ODDS_API_BASE=https://api.the-odds-api.com/v4

# Optional: Betfair Exchange (FREE delayed app key). Leave blank if unused /
# unavailable in your country.
BETFAIR_USER=
BETFAIR_PASS=
BETFAIR_APP_KEY=
